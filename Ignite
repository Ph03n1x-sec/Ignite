cat > "$STAGE_DIR/bin/kali-i3-launch" <<'LAUNCH'
#!/usr/bin/env bash
# kali-i3-launch <float|tile> <class-regex> <command> [args...]
# Starts a GUI program and, in float mode, floats and centres the window it
# opens. i3 has no one-shot window rule, so the new window is found by diffing
# the window ids in the tree before and after the launch. The class regex keeps
# two concurrent launches from floating each other's window. Run this detached
# (setsid -f) so the waiting loop never blocks an i3blocks click handler.
set -uo pipefail
[[ $# -ge 3 ]] || exit 2
mode=$1
class_re=$2
shift 2

window_ids() {
  i3-msg -t get_tree 2>/dev/null | python3 -I -c '
import json, sys
try:
    tree = json.load(sys.stdin)
except Exception:
    sys.exit(0)
found = []
def walk(node):
    if node.get("window"):
        found.append(str(node["window"]))
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        walk(child)
walk(tree)
print(" ".join(found))
'
}

# First window whose class matches, excluding the ids that existed before.
new_window() {
  i3-msg -t get_tree 2>/dev/null | python3 -I -c '
import json, re, sys
pattern = re.compile(sys.argv[1], re.I)
known = set(sys.argv[2].split())
try:
    tree = json.load(sys.stdin)
except Exception:
    sys.exit(0)
hits = []
def walk(node):
    wid = node.get("window")
    if wid and str(wid) not in known:
        props = node.get("window_properties") or {}
        if pattern.search(props.get("class") or ""):
            hits.append(str(wid))
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        walk(child)
walk(tree)
print(hits[0] if hits else "")
' "$1" "$2"
}

before=$(window_ids)
setsid -f "$@" >/dev/null 2>&1 || exit 1
[[ "$mode" == float ]] || exit 0

# code-oss on arm64 can take a long time to map its first window.
for _ in $(seq 1 150); do
  sleep 0.2
  target=$(new_window "$class_re" "$before")
  if [[ -n "$target" ]]; then
    i3-msg "[id=$target] floating enable, resize set 1100 700, move position center" \
      >/dev/null 2>&1
    exit 0
  fi
done
exit 0
LAUNCH

