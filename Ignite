_banner_for_height() {  # full phoenix when it fits the terminal, else the compact one
  local rows
  rows=$(tput lines 2>/dev/null || echo 24)
  if (( rows >= 40 )); then phoenix_banner; else _compact_banner; fi
}

phoenix_banner() {  # static banner (flags, pipes, and the install progress UI)
  _phoenix_load
  _phoenix_render 0
  _phoenix_footer
}

phoenix_ignite() {  # short "ignition": flames flow for a moment, then settle + footer
  _phoenix_load
  [[ -t 1 ]] || { phoenix_banner; return 0; }
  local frames=${1:-24} f
  printf '\033[?25l'; clear   # hide cursor, clear once; frames redraw in place
  for ((f = 0; f < frames; f++)); do
    printf '\033[H'
    _phoenix_render "$f"
    sleep 0.07
  done
  printf '\033[H'; _phoenix_render 0; _phoenix_footer
  printf '\033[?25h'
}

_menu_text() {
  cat <<'MENU'
What would you like to do?

  1) Install       Set up the Black Ph03n1x workstation (choose tools next). [recommended]
  2) Theme only    Refresh the look/configs on an existing install; leave tools untouched.
  3) Transparent   Turn ON experimental terminal transparency (needs an install already).
  4) Safe mode     Force opaque terminals and stop the compositor (fixes transparency glitches).
  5) Patch         Apply post-install fixes (Wine noise, etc.) to an existing install.
  6) Check         Verify an existing install and report status; changes nothing.
  7) Help          Show the full usage text and exit.
  8) Quit          Exit without doing anything.
MENU
}

_apply_choice() {  # map a key to MODE; exits for help/quit; returns 1 to keep waiting
  case "$1" in
    1|'') MODE=install ;;
    2)    MODE=theme ;;
    3)    MODE=transparent ;;
    4)    MODE=safe ;;
    5)    MODE=patch ;;
    6)    MODE=check ;;
    7)    printf '\033[?25h'; clear 2>/dev/null; usage; exit 0 ;;
    8|q|Q) printf '\033[?25h'; clear 2>/dev/null; say 'Nothing to do. Bye!'; exit 0 ;;
    *)    return 1 ;;
  esac
  return 0
}

_yn() { (( $1 )) && printf '[\033[1;32mY\033[0m]' || printf '[\033[1;31mN\033[0m]'; }

choose_components() {
  local key arch_note_veil='' arch_note_shellter=''
  local _ga; _ga=$(dpkg --print-architecture 2>/dev/null || echo unknown)
  [[ "$_ga" == arm64 ]] && arch_note_veil='  (slow on arm64)' \
                        && arch_note_shellter='  (needs Veil container on arm64)'
  while :; do
    printf '\033[2J\033[H'
    _compact_banner
    printf '  The Black Ph03n1x desktop is always included. Toggle which tools to add:\n\n'
    printf '  %b 1) Donut        Shellcode-to-PE generator\n' "$(_yn "$INSTALL_DONUT")"
    printf '  %b 2) Veil         AV-evasion payload generator%s\n' "$(_yn "$INSTALL_VEIL")" "$arch_note_veil"
    printf '  %b 3) Shellter     PE injection tool%s\n' "$(_yn "$INSTALL_SHELLTER")" "$arch_note_shellter"
    printf '  %b 4) Obsidian     Note-taking app with OSED vault\n' "$(_yn "$INSTALL_OBSIDIAN")"
    printf '  %b 5) TLoggerV3.1   Ph03n1x terminal logger\n' "$(_yn "$INSTALL_TLOGGER")"
    printf '\n  Press 1-5 to toggle, a = all on, n = all off, Enter to start, q to go back: '
    read -rsn1 key
    case "$key" in
      1) INSTALL_DONUT=$(( 1 - INSTALL_DONUT )) ;;
      2) INSTALL_VEIL=$(( 1 - INSTALL_VEIL ))
         if [[ "$INSTALL_VEIL" -eq 0 && "$_ga" == arm64 ]]; then
           INSTALL_SHELLTER=0
         fi ;;
      3) INSTALL_SHELLTER=$(( 1 - INSTALL_SHELLTER ))
         if [[ "$INSTALL_SHELLTER" -eq 1 && "$_ga" == arm64 && "$INSTALL_VEIL" -eq 0 ]]; then
           INSTALL_VEIL=1
         fi ;;
      4) INSTALL_OBSIDIAN=$(( 1 - INSTALL_OBSIDIAN )) ;;
      5) INSTALL_TLOGGER=$(( 1 - INSTALL_TLOGGER )) ;;
      a|A) INSTALL_DONUT=1; INSTALL_VEIL=1; INSTALL_SHELLTER=1; INSTALL_OBSIDIAN=1; INSTALL_TLOGGER=1 ;;
      n|N) INSTALL_DONUT=0; INSTALL_VEIL=0; INSTALL_SHELLTER=0; INSTALL_OBSIDIAN=0; INSTALL_TLOGGER=0 ;;
      ''|$'\n') printf '\n'; return 0 ;;
      q|Q) return 1 ;;
    esac
  done
}

choose_mode() {
  # Print the phoenix as normal output (never clear the screen). If the whole
  # screen fits, keep the flames burning live while waiting for a keypress by
  # repainting only the phoenix each tick and parking the cursor at the prompt.
  # Shorter terminals get a one-time flicker, then a plain prompt (no corruption).
  local key rows art total f off=0 up
  _phoenix_load
  art=${#PHOENIX_ART[@]}
  rows=$(tput lines 2>/dev/null || echo 0)
  total=$(( art + 17 ))          # phoenix + footer(5) + menu(10) + blank(1) + prompt(1)
  up=$(( art + 16 ))             # lines from the prompt up to the top of the phoenix
  _phoenix_render 0
  if [[ -t 1 ]] && (( rows > art + 1 )) && (( rows < total )); then
    for ((f = 1; f <= 14; f++)); do
      printf '\033[%dA' "$art"; _phoenix_render "$f"; sleep 0.06
    done
  fi
  _phoenix_footer
  _menu_text
  printf '\n'
  if [[ -t 1 ]] && (( rows >= total )); then
    printf '   Press 1-8  (Enter = Install): '
    printf '\033[s'                        # remember the prompt position
    trap 'printf "\033[?25h\033[0m"; exit 130' INT
    printf '\033[?25l'                      # hide cursor during the animation
    while :; do
      off=$(( off + 1 ))
      printf '\033[u\033[%dA' "$up"         # jump to the top of the phoenix
      _phoenix_render "$off"                # repaint it with shifted flame colours
      printf '\033[u'                       # back to the prompt
      if read -rsn1 -t 0.12 key; then
        if _apply_choice "$key"; then printf '\033[?25h\n'; break; fi
      fi
    done
    trap - INT
  else
    read -rp '   Enter a number [1-8] (default 1): ' key || { printf '\n'; exit 0; }
    printf '\n'
    _apply_choice "${key:-1}" || die "Invalid choice: '$key' (expected 1-8)."
  fi
  if [[ "$MODE" == install ]]; then
    choose_components || { choose_mode; return; }
    if [[ -t 0 && -t 1 ]]; then
      local _h
      printf '\n  Your username is used in the Obsidian vault name and TLoggerV3.1 messages.\n'
      read -rp "  Username [${USER_NAME}]: " _h
      [[ -n "$_h" ]] && USER_NAME="$_h"
    fi
  fi
}

ui_supported() { [[ -t 1 && -t 2 ]]; }

ui_bar() {  # ui_bar <pct> -> a 34-cell bar string
  local pct=$1 width=34 filled i out=''
  (( pct < 0 )) && pct=0; (( pct > 100 )) && pct=100
  filled=$(( pct * width / 100 ))
  for ((i = 0; i < width; i++)); do
    if (( i < filled )); then out+='█'; else out+='░'; fi
  done
  printf '%s' "$out"
}

ui_begin() {  # start the install progress view (install/theme, terminal only)
  ui_supported || return 0
  case "$MODE" in
    install)
      UI_TOTAL=4
      if [[ "$GUEST_ARCH" == arm64 ]]; then
        [[ "$INSTALL_DONUT"    -eq 1 ]] && UI_TOTAL=$(( UI_TOTAL + 1 ))
        [[ "$INSTALL_VEIL"     -eq 1 ]] && UI_TOTAL=$(( UI_TOTAL + 1 ))
        [[ "$INSTALL_SHELLTER" -eq 1 ]] && UI_TOTAL=$(( UI_TOTAL + 1 ))
      fi
      [[ "$INSTALL_OBSIDIAN" -eq 1 ]] && UI_TOTAL=$(( UI_TOTAL + 1 ))
      [[ "$INSTALL_TLOGGER"  -eq 1 ]] && UI_TOTAL=$(( UI_TOTAL + 1 ))
      ;;
    theme)   UI_TOTAL=3 ;;
    *)       return 0 ;;
  esac
  exec 3>/dev/tty || return 0
  UI_ON=1
  _banner_for_height >&3 2>/dev/null          # show the phoenix once (normal output)
  # Cache sudo now, while its prompt is still visible, before output is redirected.
  printf '\n   Requesting sudo access (needed to install Kali packages)...\n\n' >&3
  sudo -v || die 'sudo is required to install Kali packages.'
  LOG=$(mktemp -t ignite.XXXXXX.log)
  exec >>"$LOG" 2>&1   # tuck noisy command output into the log; phases print below
  UI_STEP=0
  printf '\n' >&3 2>/dev/null || true
}

progress() {  # progress "<label>": print one appended phase line with a small bar
  if [[ "$UI_ON" -ne 1 ]]; then say "$*"; return 0; fi
  UI_CUR="$*"
  UI_STEP=$(( UI_STEP + 1 ))
  local pct=$(( UI_STEP * 100 / UI_TOTAL ))
  (( pct > 100 )) && pct=100
  printf '   \033[38;5;208m[%d/%d]\033[0m %-38s \033[38;5;196m%s\033[0m \033[1m%3d%%\033[0m\n' \
    "$UI_STEP" "$UI_TOTAL" "$*" "$(ui_bar "$pct")" "$pct" >&3 2>/dev/null || true
}

ui_finish() {  # all done: print the 100% line and a success panel
  [[ "$UI_ON" -ne 1 ]] && return 0
  UI_CUR=
  {
    printf '\n   \033[38;5;196m%s\033[0m \033[1;38;5;46m100%% complete\033[0m\n' "$(ui_bar 100)"
    printf '\n   \033[1;38;5;46mBlack Ph03n1x is ready.\033[0m   \033[38;5;45mhttps://ph03n1x.net\033[0m\n\n'
    printf '   - Log out and back into i3 to load the desktop.\n'
    printf '   - Super+Return: terminal    Super+d: app launcher\n'
    printf '   - flameshot button far left, Obsidian button right of mousepad.\n'
    printf '   - Re-run with --check to verify, or --help for all options.\n\n'
  } >&3 2>/dev/null || true
  [[ -n "$LOG" && -f "$LOG" ]] && rm -f "$LOG"
}

if [[ $# -eq 0 ]]; then
  # No flags: the animated phoenix + interactive menu when we have a terminal;
  # otherwise a static banner and a default full install (keeps 'curl | bash' ok).
  if [[ -t 0 && -t 1 ]]; then
    choose_mode
  else
    phoenix_banner
  fi
else
  phoenix_banner
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --desktop-only) INSTALL_DONUT=0; INSTALL_VEIL=0; INSTALL_SHELLTER=0; INSTALL_OBSIDIAN=0; INSTALL_TLOGGER=0 ;;
      --skip-veil)    INSTALL_VEIL=0; INSTALL_SHELLTER=0 ;;
      --no-obsidian)  INSTALL_OBSIDIAN=0 ;;
      --no-tlogger)   INSTALL_TLOGGER=0 ;;
      --username)     shift; [[ -n "${1:-}" ]] || die '--username requires a name'; USER_NAME="$1" ;;
      --theme-only) MODE=theme ;;
      --transparent) MODE=transparent ;;
      --safe-mode) MODE=safe ;;
      --patch) MODE=patch ;;
      --check) MODE=check ;;
      --help|-h) usage; exit 0 ;;
      *) usage >&2; exit 2 ;;
    esac
    shift
  done
fi

[[ "$(uname -s)" == Linux ]] || die 'This installer must run inside the Kali VM, not on macOS.'
[[ -r /etc/os-release ]] || die 'Cannot identify this Linux distribution.'
# /etc/os-release is the guest operating system's own metadata.
# shellcheck disable=SC1091
. /etc/os-release
[[ "${ID:-}" == kali ]] || die "Expected Kali Linux; found ${ID:-unknown}."
[[ "$(id -u)" -ne 0 ]] || die 'Run this as your normal Kali user, without sudo.'
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
WALLPAPER_SOURCE=
for wallpaper_candidate in "$SCRIPT_DIR/black_phoenix.png" "$HOME/Desktop/black_phoenix.png"; do
  if [[ -s "$wallpaper_candidate" ]]; then
    WALLPAPER_SOURCE="$wallpaper_candidate"
    break
  fi
done

GUEST_ARCH=$(dpkg --print-architecture)
case "$GUEST_ARCH" in
  arm64|amd64) ;;
  *) die "Unsupported guest architecture: $GUEST_ARCH (expected arm64 or amd64)." ;;
esac
say "Guest architecture: $GUEST_ARCH ($(uname -m))."
if [[ "$GUEST_ARCH" == arm64 && "$MODE" == install ]]; then
  [[ "$INSTALL_DONUT" -eq 1 ]] && say 'ARM64 Kali detected. The Donut CLI will use a private amd64 runtime.'
  [[ "$INSTALL_VEIL"  -eq 1 ]] && say 'Veil and Shellter will run in a Docker container (emulated amd64).'
fi

cleanup() {
  local exit_status=$?
  printf '\033[?25h' >/dev/tty 2>/dev/null || true   # always restore the cursor
  if [[ -n "$STAGE_DIR" && -d "$STAGE_DIR" ]]; then
    rm -r -- "$STAGE_DIR"
  fi
  if [[ "$exit_status" -ne 0 && "$DESKTOP_INSTALLED" -eq 1 ]]; then
    say 'The desktop files were installed, but a later step failed. Check the error above; you can rerun this script safely.'
  fi
  # With the progress UI active, command output was hidden in $LOG; on failure,
  # surface where to look and the last lines of that log on the actual screen.
  if [[ "$UI_ON" -eq 1 && "$exit_status" -ne 0 ]]; then
    {
      printf '\n   \033[1;31mInstall failed'
      [[ -n "$UI_CUR" ]] && printf ' during: %s' "$UI_CUR"
      printf '.\033[0m\n'
      [[ -n "$LOG" && -f "$LOG" ]] && printf '   Full log: %s\n\n   --- last lines ---\n' "$LOG"
    } >&3 2>/dev/null || true
    [[ -n "$LOG" && -f "$LOG" ]] && tail -n 15 "$LOG" >&3 2>/dev/null || true
  fi
}
trap cleanup EXIT

backup_one() {
  local source=$1 relative
  [[ -e "$source" || -L "$source" ]] || return 0
  relative=${source#"$HOME"/}
  mkdir -p "$BACKUP_DIR/$(dirname "$relative")"
  cp -a -- "$source" "$BACKUP_DIR/$relative"
}

append_shell_hook() {
  local rc_file=$1 marker='# kali-i3-setup terminal naming' resolved
  if [[ -f "$rc_file" ]] && grep -Fq "$marker" "$rc_file"; then
    return 0
  fi
  backup_one "$rc_file"
  if [[ -L "$rc_file" ]]; then
    resolved=$(readlink -f -- "$rc_file") || die "Broken shell configuration symlink: $rc_file"
    [[ -f "$resolved" ]] || die "Shell configuration symlink does not point to a file: $rc_file"
    mkdir -p "$BACKUP_DIR/shell-rc-targets"
    cp -a -- "$resolved" "$BACKUP_DIR/shell-rc-targets/$(basename "$rc_file")"
  fi
  {
    printf '\n%s\n' "$marker"
    printf '%s\n' '[ -f "$HOME/.config/kali-i3/terminal-title.sh" ] && . "$HOME/.config/kali-i3/terminal-title.sh"'
  } >> "$rc_file"
}

append_tlogger_hook() {
  local rc_file=$1 marker='# kali-i3-setup tlogger'
  if [[ -f "$rc_file" ]] && grep -Fq "$marker" "$rc_file"; then
    return 0
  fi
  backup_one "$rc_file"
  if [[ -L "$rc_file" ]]; then
    local resolved
    resolved=$(readlink -f -- "$rc_file") || die "Broken shell configuration symlink: $rc_file"
    [[ -f "$resolved" ]] || die "Shell configuration symlink does not point to a file: $rc_file"
    mkdir -p "$BACKUP_DIR/shell-rc-targets"
    cp -a -- "$resolved" "$BACKUP_DIR/shell-rc-targets/$(basename "$rc_file").tlogger"
  fi
  {
    printf '\n%s\n' "$marker"
    printf '%s\n' '[ -f "$HOME/.config/kali-i3/tlogger.sh" ] && . "$HOME/.config/kali-i3/tlogger.sh"'
  } >> "$rc_file"
}

check_setup() {
  local failed=0 helper
  for helper in i3 rofi i3blocks xfce4-terminal thunar zsh xfconf-query picom feh flameshot; do
    if command -v "$helper" >/dev/null 2>&1; then
      say "OK: $helper"
    else
      say "MISSING: $helper"
      failed=1
    fi
  done
  if [[ -f "$HOME/.config/i3/config" ]] && i3 -C -c "$HOME/.config/i3/config"; then
    say 'OK: i3 configuration parses.'
  else
    say 'FAILED: i3 configuration.'
    failed=1
  fi
  if [[ -s "$HOME/.config/rofi/config.rasi" ]]; then
    say 'OK: Rofi configuration is present. Test Super+d after logging into i3.'
  else
    say 'FAILED: Rofi configuration is missing.'
    failed=1
  fi
  for helper in kali-i3-named-terminal kali-i3-files-menu kali-i3-files-block kali-i3-code-block kali-i3-mousepad-block kali-i3-flameshot-block kali-i3-obsidian-block kali-i3-remmina-block kali-i3-shift-held kali-i3-launch kali-i3-resize kali-i3-battery-block kali-i3-power-block kali-i3-power-menu kali-i3-vpn-block kali-i3-terminal-theme kali-i3-session-start kali-i3-titlebar-menu kali-i3-transfer-menu px; do
    if [[ -f "$HOME/.local/bin/$helper" ]] && bash -n "$HOME/.local/bin/$helper"; then
      say "OK: $helper"
    else
      say "FAILED: $helper"
      failed=1
    fi
  done
  if [[ -s "$HOME/.local/share/kali-i3-setup/phoenix-wallpaper.png" ]]; then
    say 'OK: Black Ph03n1x wallpaper is installed.'
  else
    say 'FAILED: Black Ph03n1x wallpaper is missing.'
    failed=1
  fi
  if [[ -f "$HOME/.config/kali-i3/terminal-title.sh" ]] &&
     zsh -n "$HOME/.config/kali-i3/terminal-title.sh"; then
    say 'OK: Black Ph03n1x Zsh prompt parses.'
  else
    say 'FAILED: Black Ph03n1x Zsh prompt.'
    failed=1
  fi
  if [[ -f "$HOME/.config/kali-i3/disable-transparency" ]]; then
    say 'OK: Stable opaque terminal mode is enabled.'
  fi
  if grep -q 'zoom-in-alt' "$HOME/.config/xfce4/terminal/accels.scm" 2>/dev/null; then
    say 'OK: Ctrl+= enlarges terminal text.'
  else
    say 'FAILED: Terminal zoom accelerators are not installed.'
    failed=1
  fi
  # xfce4-terminal 1.2.0 ignores its own default-working-dir preference, so the
  # directory is passed on each launch instead.
  if grep -q 'working-directory=' "$HOME/.config/i3/config" 2>/dev/null; then
    say 'OK: New terminals open in ~/Desktop.'
  else
    say 'FAILED: New terminals do not open in ~/Desktop.'
    failed=1
  fi
  local _state="${XDG_STATE_HOME:-$HOME/.local/state}/kali-i3-setup"
  if command -v donut >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/donut" ]]; then
    local donut_cmd=donut help_text
    [[ -x "$HOME/.local/bin/donut" ]] && donut_cmd="$HOME/.local/bin/donut"
    help_text=$("$donut_cmd" -h 2>&1) || true
    if [[ "$help_text" == *'usage: donut'* ]]; then
      say 'OK: Donut CLI starts.'
    else
      say 'FAILED: Donut CLI did not show its help text.'
      failed=1
    fi
  else
    if [[ -f "$_state/skip-donut" ]]; then
      say 'Donut was intentionally skipped.'
    else
      say 'FAILED: Donut CLI is absent. Re-run the installer.'
      failed=1
    fi
  fi
  if command -v veil >/dev/null 2>&1; then
    local veil_version
    if [[ "$GUEST_ARCH" == arm64 ]]; then
      veil_version=$(docker exec veil-box veil --version 2>&1) || true
      if [[ "$veil_version" == *'permission denied'* ]]; then
        veil_version=$(sudo docker exec veil-box veil --version 2>&1) || true
      fi
    else
      veil_version=$(veil --version 2>&1) || true
    fi
    if [[ "$veil_version" == *'Veil'* ]]; then
      say 'OK: Veil starts.'
    else
      say 'FAILED: Veil did not report its version.'
      failed=1
    fi
  else
    if [[ -f "$_state/skip-veil" ]]; then
      say 'Veil was intentionally skipped.'
    else
      say 'FAILED: Veil is absent. Re-run the installer.'
      failed=1
    fi
  fi
  if command -v shellter >/dev/null 2>&1; then
    local shellter_check
    if [[ "$GUEST_ARCH" == arm64 ]]; then
      shellter_check=$(docker exec veil-box dpkg-query -W shellter 2>&1) || true
      if [[ "$shellter_check" == *'permission denied'* ]]; then
        shellter_check=$(sudo docker exec veil-box dpkg-query -W shellter 2>&1) || true
      fi
    else
      shellter_check=$(dpkg-query -W shellter 2>&1) || true
    fi
    if [[ "$shellter_check" == *'shellter'* ]]; then
      say 'OK: Shellter is installed.'
    else
      say 'FAILED: Shellter package not found in container.'
      failed=1
    fi
  else
    if [[ -f "$_state/skip-shellter" ]]; then
      say 'Shellter was intentionally skipped.'
    else
      say 'FAILED: Shellter is absent. Re-run the installer.'
      failed=1
    fi
  fi
  if [[ -x "$HOME/.local/bin/obsidian" && -x "$HOME/.local/share/kali-i3-setup/obsidian/AppRun" ]]; then
    say 'OK: Obsidian is installed.'
  else
    if [[ -f "$_state/skip-obsidian" ]]; then
      say 'Obsidian was intentionally skipped.'
    else
      say 'Obsidian is not installed (optional; rerun the installer to add it).'
    fi
  fi
  if [[ -f "$HOME/.config/kali-i3/tlogger.sh" ]] &&
     zsh -n "$HOME/.config/kali-i3/tlogger.sh" 2>/dev/null; then
    say 'OK: TLoggerV3.1 is installed and parses.'
  else
    if [[ -f "$_state/skip-tlogger" ]]; then
      say 'TLoggerV3.1 was intentionally skipped.'
    else
      say 'TLoggerV3.1 is not installed (optional; rerun the installer to add it).'
    fi
  fi
  return "$failed"
}

apply_patches() {
  local patched=0
  # ── Shellter: suppress Wine debug noise ──
  if [[ -f /usr/local/bin/shellter ]]; then
    if grep -q 'docker exec' /usr/local/bin/shellter &&
       ! grep -q 'WINEDEBUG=-all' /usr/local/bin/shellter; then
      say 'Patching Shellter wrapper: suppressing Wine debug noise (WINEDEBUG=-all).'
      sudo sed -i 's/docker exec -it veil-box/docker exec -it -e WINEDEBUG=-all veil-box/g' /usr/local/bin/shellter
      patched=$(( patched + 1 ))
    else
      say 'OK: Shellter wrapper already suppresses Wine noise.'
    fi
  else
    say 'Shellter wrapper not found; nothing to patch.'
  fi
  if (( patched == 0 )); then
    say 'Everything is already up to date.'
  else
    say "$patched patch(es) applied."
  fi
}

