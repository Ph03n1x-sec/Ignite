_phoenix_render() {  # _phoenix_render [offset]: print the art, flame colours flowing by offset
  local off=${1:-0} i n p=${#PHOENIX_PALETTE[@]} idx
  n=${#PHOENIX_ART[@]}
  for ((i = 0; i < n; i++)); do
    if [[ -t 1 ]]; then
      idx=$(( (i * p / n + off) % p ))
      printf '\033[38;5;%sm%s\033[0m\n' "${PHOENIX_PALETTE[idx]}" "${PHOENIX_ART[i]}"
    else
      printf '%s\n' "${PHOENIX_ART[i]}"
    fi
  done
}

