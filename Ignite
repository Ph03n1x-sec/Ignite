install_arm64_donut() {
  local index_dir index_file bundle_dir package_name record package_path package_sha
  local deb_file package_arch loader libc_dir help_text
  index_dir="$STAGE_DIR/amd64-packages"
  bundle_dir="$STAGE_DIR/donut-amd64"
  mkdir -p "$index_dir" "$bundle_dir"
  index_file="$index_dir/Packages.gz"
  say 'Downloading the current Kali amd64 package index for Donut.'
  curl --fail --location --retry 3 --output "$index_file" \
    "$KALI_MIRROR/dists/kali-rolling/main/binary-amd64/Packages.gz"

  for package_name in donut libc6; do
    record=$(python3 - "$index_file" "$package_name" <<'PY'
import gzip
import sys

index_path, wanted = sys.argv[1:]
entry = {}
with gzip.open(index_path, 'rt', encoding='utf-8') as index:
    for line in index:
        line = line.rstrip('\n')
        if not line:
            if entry.get('Package') == wanted and entry.get('Architecture') == 'amd64':
                print(entry['Filename'], entry['SHA256'])
                break
            entry = {}
        elif not line[0].isspace() and ': ' in line:
            key, value = line.split(': ', 1)
            entry[key] = value
    else:
        if entry.get('Package') == wanted and entry.get('Architecture') == 'amd64':
            print(entry['Filename'], entry['SHA256'])
        else:
            raise SystemExit(f'{wanted}:amd64 not found in Kali package index')
PY
    ) || die "Could not locate $package_name:amd64 in the Kali index."
    read -r package_path package_sha <<< "$record"
    [[ "$package_path" == pool/* ]] || die "Unexpected package path for $package_name."
    [[ "$package_sha" =~ ^[0-9a-fA-F]{64}$ ]] || die "Invalid checksum for $package_name."
    deb_file="$index_dir/${package_path##*/}"
    say "Downloading $package_name:amd64."
    curl --fail --location --retry 3 --output "$deb_file" "$KALI_MIRROR/$package_path"
    printf '%s  %s\n' "$package_sha" "$deb_file" | sha256sum --check --status ||
      die "Checksum failed for $package_name:amd64."
    package_arch=$(dpkg-deb -f "$deb_file" Architecture)
    [[ "$package_arch" == amd64 ]] || die "Wrong package architecture: $package_arch."
    dpkg-deb -x "$deb_file" "$bundle_dir"
  done

  loader=$(find "$bundle_dir" -type f -name ld-linux-x86-64.so.2 -print -quit)
  [[ -n "$loader" && -x "$bundle_dir/usr/bin/donut" ]] ||
    die 'The private Donut bundle is missing its binary or amd64 loader.'
  libc_dir=$(dirname "$loader")
  help_text=$(qemu-x86_64 "$loader" --inhibit-cache --library-path "$libc_dir" \
    "$bundle_dir/usr/bin/donut" -h 2>&1) || true
  [[ "$help_text" == *'usage: donut'* ]] || die "Donut failed under QEMU: $help_text"

  local final_bundle="$HOME/.local/share/kali-i3-setup/donut-amd64"
  mkdir -p "$(dirname "$final_bundle")"
  if [[ -e "$final_bundle" ]]; then
    mv -- "$final_bundle" "$BACKUP_DIR/donut-amd64"
  fi
  mv -- "$bundle_dir" "$final_bundle"
  backup_one "$HOME/.local/bin/donut"
  cat > "$STAGE_DIR/bin/donut" <<'DONUT_WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
bundle="$HOME/.local/share/kali-i3-setup/donut-amd64"
loader=$(find "$bundle" -type f -name ld-linux-x86-64.so.2 -print -quit)
[[ -n "$loader" && -x "$bundle/usr/bin/donut" ]] || {
  printf 'Donut private runtime is missing. Rerun the installer.\n' >&2
  exit 1
}
exec qemu-x86_64 "$loader" --inhibit-cache --library-path "$(dirname "$loader")" \
  "$bundle/usr/bin/donut" "$@"
DONUT_WRAPPER
  bash -n "$STAGE_DIR/bin/donut"
  install -m 0755 "$STAGE_DIR/bin/donut" "$HOME/.local/bin/donut"
  say 'Donut CLI installed in ~/.local/bin/donut and tested with -h.'
}

install_arm64_veil() {
  # Veil (AV-evasion payload generator) has no arm64 build, and unlike Donut its
  # own dependency chain (Wine, Metasploit, Mono, mingw-w64, a GitHub-hosted
  # dependency bundle) is too deep to hand-extract like a single binary. Instead
  # a real amd64 Kali container runs it under qemu's binfmt_misc handler
  # (registered on the host by the qemu-user-binfmt package above), so `apt
  # install veil` inside the container resolves its dependencies the normal way.
  if command -v veil >/dev/null 2>&1; then
    say 'Veil is already installed; skipping.'
    return 0
  fi

  command -v docker >/dev/null 2>&1 || die 'docker.io did not install correctly.'
  sudo systemctl enable --now docker >/dev/null 2>&1 ||
    die 'Could not start the docker service.'

  local this_user
  this_user=$(id -un)
  if ! id -nG "$this_user" | grep -qw docker; then
    sudo usermod -aG docker "$this_user"
    say 'Added you to the docker group (needed to run `docker` without sudo). Log out and back in, or run `newgrp docker`, for that to take effect.'
  fi
  # The group just added above only applies to future logins, not this already-
  # running shell, so every docker call made by this function itself goes through
  # sudo rather than relying on group membership it cannot have yet.
  dkr() { sudo docker "$@"; }

  # Some DNS resolvers (notably some VPN/corporate ones) send responses dockerd's
  # pure-Go resolver rejects even though glibc accepts them, which makes image
  # pulls fail with "no such host" despite the host's own DNS working fine.
  # Forcing the cgo (glibc) resolver avoids that; it is a strict improvement.
  local dns_fix_dir=/etc/systemd/system/docker.service.d
  local dns_fix_file="$dns_fix_dir/ignite-dns-fix.conf"
  if [[ ! -f "$dns_fix_file" ]]; then
    sudo mkdir -p "$dns_fix_dir"
    printf '[Service]\nEnvironment="GODEBUG=netdns=cgo"\n' | sudo tee "$dns_fix_file" >/dev/null
    sudo systemctl daemon-reload
    sudo systemctl restart docker
  fi

  local veil_output="$HOME/.local/share/kali-i3-setup/veil-output"
  if dkr ps -a --format '{{.Names}}' 2>/dev/null | grep -qx veil-box; then
    say 'veil-box container already exists; reusing it.'
    dkr start veil-box >/dev/null 2>&1 || true
  else
    say 'Pulling an amd64 Kali image and creating the veil-box container (this runs emulated; it is slow).'
    mkdir -p "$veil_output"
    dkr run -d --platform linux/amd64 --name veil-box --hostname veil-box \
      --restart unless-stopped -v "$veil_output:/var/lib/veil/output" \
      kalilinux/kali-rolling sleep infinity ||
      die 'Could not create the veil-box container.'
  fi

  # Pin the container to Kali's CDN rather than the http.kali.org redirector:
  # inside Docker the redirector can resolve to a geographic mirror that the
  # container cannot reach, which aborts the apt install below.
  dkr exec veil-box bash -c \
    'echo "deb http://kali.download/kali kali-rolling main non-free non-free-firmware contrib" > /etc/apt/sources.list'

  # Install Veil only if it is not already present, so a run interrupted partway
  # (e.g. a transient mirror failure) can be repaired by simply re-running this
  # script -- the same way the Shellter step below guards itself. Previously the
  # install lived in the container-creation branch only, so a half-built,
  # already-existing container could never be completed by re-running.
  if ! dkr exec veil-box dpkg-query -W -f='${Status}' veil 2>/dev/null | grep -qx 'install ok installed'; then
    say 'Installing Veil inside veil-box (apt, under emulation — this takes a while).'
    dkr exec veil-box bash -c 'apt-get -qq update && DEBIAN_FRONTEND=noninteractive apt-get install -yqq veil xvfb lftp' ||
      die 'Failed to install veil inside veil-box.'

    say 'Running Veil''s own setup (Wine/Python/Go) inside veil-box.'
    dkr exec veil-box bash -c 'xvfb-run /usr/share/veil/config/setup.sh --force --silent' || true
    # The Ruby 1.8.7 and AutoIT installers are old 32-bit NSIS binaries that fail
    # to load under this nested qemu+Wine emulation (unrelated to arm64 itself);
    # Veil only hard-requires their files to *exist* at startup, so stub them.
    # Python/C/PowerShell/Go payloads are unaffected; Ruby/AutoIT payloads are not usable.
    dkr exec veil-box bash -c '
      mkdir -p "/var/lib/veil/wine/drive_c/Ruby187/bin" \
               "/var/lib/veil/wine/drive_c/Program Files/AutoIt3/Aut2Exe"
      touch "/var/lib/veil/wine/drive_c/Ruby187/bin/ruby.exe" \
            "/var/lib/veil/wine/drive_c/Program Files/AutoIt3/Aut2Exe/Aut2exe.exe"
    '
    # Veil writes payloads as root inside the container; reclaim the bind mount
    # so generated files are owned by the normal user, not root.
    mkdir -p "$veil_output"
    sudo chown -R "$this_user:$this_user" "$veil_output"
  fi

  local version_text
  version_text=$(dkr exec veil-box veil --version 2>&1) || true
  [[ "$version_text" == *'Veil'* ]] || die "Veil failed to start in veil-box: $version_text"

  cat > "$STAGE_DIR/bin/veil" <<'VEIL_WRAPPER'
#!/usr/bin/env bash
# Runs Veil (amd64 Kali container, emulated via qemu binfmt) from the arm64 host.
if docker exec -it veil-box veil "$@" 2>/tmp/.veil-wrapper-err; then
  exit 0
fi
if grep -q 'permission denied' /tmp/.veil-wrapper-err 2>/dev/null; then
  rm -f /tmp/.veil-wrapper-err
  exec sudo docker exec -it veil-box veil "$@"
fi
cat /tmp/.veil-wrapper-err >&2
rm -f /tmp/.veil-wrapper-err
exit 1
VEIL_WRAPPER
  bash -n "$STAGE_DIR/bin/veil"
  sudo install -m 0755 "$STAGE_DIR/bin/veil" /usr/local/bin/veil
  say 'Veil installed. Run `veil`; output lands in ~/.local/share/kali-i3-setup/veil-output/.'
}

install_arm64_shellter() {
  # Shellter (PE injection tool) is amd64-only in Kali repos, and runs under Wine.
  # It reuses the veil-box container that install_arm64_veil() already created.
  if command -v shellter >/dev/null 2>&1; then
    say 'Shellter is already installed; skipping.'
    return 0
  fi

  dkr() { sudo docker "$@"; }

  if ! dkr ps -a --format '{{.Names}}' 2>/dev/null | grep -qx veil-box; then
    die 'veil-box container does not exist. Shellter requires the Veil container (do not use --skip-veil).'
  fi
  dkr start veil-box >/dev/null 2>&1 || true

  if ! dkr exec veil-box dpkg-query -W shellter >/dev/null 2>&1; then
    say 'Installing Shellter inside veil-box.'
    dkr exec veil-box bash -c \
      'dpkg --add-architecture i386 && apt-get -qq update && DEBIAN_FRONTEND=noninteractive apt-get install -yqq shellter wine32:i386' ||
      die 'Failed to install shellter inside veil-box.'
  fi

  cat > "$STAGE_DIR/bin/shellter" <<'SHELLTER_WRAPPER'
#!/usr/bin/env bash
# Runs Shellter (amd64 Kali container, emulated via qemu binfmt) from the arm64 host.
# Shellter is interactive (Wine console app) and needs a virtual framebuffer.
# WINEDEBUG=-all silences harmless Wine diagnostic noise (OLE, setupapi, winebth).
if docker exec -it -e WINEDEBUG=-all veil-box xvfb-run -a shellter "$@" 2>/tmp/.shellter-wrapper-err; then
  exit 0
fi
if grep -q 'permission denied' /tmp/.shellter-wrapper-err 2>/dev/null; then
  rm -f /tmp/.shellter-wrapper-err
  exec sudo docker exec -it -e WINEDEBUG=-all veil-box xvfb-run -a shellter "$@"
fi
cat /tmp/.shellter-wrapper-err >&2
rm -f /tmp/.shellter-wrapper-err
exit 1
SHELLTER_WRAPPER
  bash -n "$STAGE_DIR/bin/shellter"
  sudo install -m 0755 "$STAGE_DIR/bin/shellter" /usr/local/bin/shellter
  say 'Shellter installed. Run `shellter` to inject payloads into PE executables.'
}

install_obsidian() {
  # Obsidian is proprietary and not in the Kali repos. The vendor ships an amd64
  # .deb but NO arm64 .deb, so the portable AppImage (published for both arches)
  # is used uniformly: download the latest, extract it once (no FUSE needed), and
  # run its AppRun through a small wrapper. Electron's system libraries come in as
  # dependencies of code-oss, which this script already installs.
  local arch=$1 api_json url appimage extract_dir dest icon
  dest="$HOME/.local/share/kali-i3-setup/obsidian"
  if [[ -x "$dest/AppRun" && -x "$HOME/.local/bin/obsidian" ]]; then
    say 'Obsidian is already installed; skipping its download. Delete it to force a reinstall.'
    return 0
  fi
  say 'Installing Obsidian from the official AppImage.'
  api_json=$(curl -fsSL --max-time 30 \
    https://api.github.com/repos/obsidianmd/obsidian-releases/releases/latest) ||
    { say 'Obsidian: could not reach the GitHub release API; skipping.'; return 1; }
  if [[ "$arch" == arm64 ]]; then
    url=$(printf '%s\n' "$api_json" | grep -oE 'https://[^"]*-arm64\.AppImage' | head -1)
  else
    url=$(printf '%s\n' "$api_json" | grep -oE 'https://[^"]*\.AppImage' | grep -v arm64 | head -1)
  fi
  [[ -n "$url" ]] || { say "Obsidian: no AppImage asset for $arch; skipping."; return 1; }
  extract_dir="$STAGE_DIR/obsidian"
  mkdir -p "$extract_dir"
  appimage="$extract_dir/Obsidian.AppImage"
  say "Downloading ${url##*/} (~130 MB)."
  curl -fL --retry 3 --max-time 600 -o "$appimage" "$url" ||
    { say 'Obsidian: download failed; skipping.'; return 1; }
  chmod +x "$appimage"
  ( cd "$extract_dir" && "$appimage" --appimage-extract >/dev/null 2>&1 ) ||
    { say 'Obsidian: AppImage extraction failed; skipping.'; return 1; }
  [[ -x "$extract_dir/squashfs-root/AppRun" ]] ||
    { say 'Obsidian: extracted bundle is missing AppRun; skipping.'; return 1; }
  mkdir -p "$(dirname "$dest")"
  if [[ -e "$dest" ]]; then
    rm -rf "$BACKUP_DIR/obsidian" 2>/dev/null || true
    mv -- "$dest" "$BACKUP_DIR/obsidian"
  fi
  mv -- "$extract_dir/squashfs-root" "$dest"
  icon="$dest/obsidian.png"
  backup_one "$HOME/.local/bin/obsidian"
  cat > "$STAGE_DIR/bin/obsidian" <<'OBS_WRAPPER'
#!/usr/bin/env bash
# chrome-sandbox is not SUID for an unprivileged, user-extracted AppImage, so
# --no-sandbox is required here; acceptable for a local notes application.
exec "$HOME/.local/share/kali-i3-setup/obsidian/AppRun" --no-sandbox "$@"
OBS_WRAPPER
  bash -n "$STAGE_DIR/bin/obsidian" ||
    { say 'Obsidian: wrapper failed its syntax check; skipping.'; return 1; }
  install -m 0755 "$STAGE_DIR/bin/obsidian" "$HOME/.local/bin/obsidian"
  backup_one "$HOME/.local/share/applications/obsidian.desktop"
  mkdir -p "$HOME/.local/share/applications"
  cat > "$HOME/.local/share/applications/obsidian.desktop" <<OBS_DESKTOP
[Desktop Entry]
Type=Application
Name=Obsidian
Comment=Markdown knowledge base / notes
Exec=$HOME/.local/bin/obsidian %u
Icon=$icon
Terminal=false
Categories=Office;Utility;
MimeType=x-scheme-handler/obsidian;
StartupWMClass=obsidian
OBS_DESKTOP
  command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
  say 'Obsidian installed. Launch it from Rofi (Super+d) or the 💎 bar button.'
}

provision_obsidian_vault() {
  # Pre-create a ready-to-use Obsidian vault at ~/Documents/$USER_NAME and register
  # it so Obsidian opens straight into it. Everything here is idempotent and
  # non-destructive: JSON is merged (never overwritten), existing notes are left
  # alone, and only our own snippet file is written outright. The snippet hides
  # image files (pasted screenshots) from the File Explorer; notes still render
  # them inline.
  local vault cfgdir
  vault="$HOME/Documents/$USER_NAME"
  cfgdir="$vault/.obsidian"
  mkdir -p "$cfgdir/snippets"
  cat > "$cfgdir/snippets/hide-images.css" <<'CSS'
/* Hide pasted/attached image files from the File Explorer pane.
   Images still display inside notes; only the explorer rows are hidden.
   Case-insensitive so .PNG / .png both match. */
.nav-file:has(> .nav-file-title[data-path$=".png" i]),
.nav-file:has(> .nav-file-title[data-path$=".jpg" i]),
.nav-file:has(> .nav-file-title[data-path$=".jpeg" i]),
.nav-file:has(> .nav-file-title[data-path$=".gif" i]),
.nav-file:has(> .nav-file-title[data-path$=".webp" i]),
.nav-file:has(> .nav-file-title[data-path$=".bmp" i]),
.nav-file:has(> .nav-file-title[data-path$=".svg" i]) {
  display: none;
}
CSS
  # Enable the snippet (merge into any existing appearance.json).
  python3 -I - "$cfgdir/appearance.json" <<'PY' || { say 'Obsidian vault: could not enable the snippet.'; return 1; }
import json, os, sys
path = sys.argv[1]
data = {}
if os.path.exists(path):
    try:
        with open(path) as handle:
            data = json.load(handle)
    except Exception:
        data = {}
snippets = data.get("enabledCssSnippets") or []
if "hide-images" not in snippets:
    snippets.append("hide-images")
data["enabledCssSnippets"] = snippets
with open(path, "w") as handle:
    json.dump(data, handle, indent=2)
PY
  # Register the vault so Obsidian opens it on launch (merge; keep other vaults).
  mkdir -p "$HOME/.config/obsidian"
  python3 -I - "$HOME/.config/obsidian/obsidian.json" "$vault" <<'PY' || { say 'Obsidian vault: could not register it; pick it from the vault switcher instead.'; return 1; }
import json, os, secrets, sys, time
path, vault = sys.argv[1], sys.argv[2]
data = {}
if os.path.exists(path):
    try:
        with open(path) as handle:
            data = json.load(handle)
    except Exception:
        data = {}
vaults = data.setdefault("vaults", {})
for info in vaults.values():
    if info.get("path") == vault:
        info["open"] = True
        break
else:
    vaults[secrets.token_hex(8)] = {"path": vault, "ts": int(time.time() * 1000), "open": True}
with open(path, "w") as handle:
    json.dump(data, handle)
PY
  # --- Community plugins, from each project's official GitHub release. ---
  # Non-fatal: a download failure just skips that plugin (install it later from
  # Settings -> Community plugins). Already-installed plugins are left untouched.
  # On first launch Obsidian may still ask to turn Community plugins on once.
  mkdir -p "$cfgdir/plugins"
  _install_obsidian_plugin() {  # usage: _install_obsidian_plugin <id> <owner/repo>
    local id=$1 repo=$2 dir="$cfgdir/plugins/$1" tmp rel asset url
    [[ -s "$dir/main.js" && -s "$dir/manifest.json" ]] && return 0  # already present
    tmp=$(mktemp -d)
    rel=$(curl -fsSL --max-time 30 "https://api.github.com/repos/$repo/releases/latest") ||
      { rm -rf "$tmp"; return 1; }
    for asset in manifest.json main.js styles.css; do
      url=$(printf '%s\n' "$rel" | grep -oE "https://[^\"]*/download/[^\"]*/$asset" | head -1)
      [[ -n "$url" ]] && curl -fsSL --max-time 180 -o "$tmp/$asset" "$url"
    done
    [[ -s "$tmp/main.js" && -s "$tmp/manifest.json" ]] || { rm -rf "$tmp"; return 1; }
    rm -rf "$dir"; mkdir -p "$dir"; mv "$tmp"/* "$dir"/; rm -rf "$tmp"
  }
  local plugin_specs spec pid prepo enable_ids
  plugin_specs=(
    "dataview blacksmithgu/obsidian-dataview"
    "table-editor-obsidian tgrosinger/advanced-tables-obsidian"
