cat > "$STAGE_DIR/bin/kali-i3-resize" <<'RESIZE'
#!/usr/bin/env bash
# kali-i3-resize <left|right|up|down>
# Moves the window's adjustable border in the direction pressed, so the same
# two arrow keys both grow and shrink it: grow the right-hand window leftwards
# with Left, then give the space back with Right. The border that moves is the
# one facing a neighbour, which is why no Shift key is needed.
#
# i3's config language has no conditionals, and chaining two resize commands
# with ';' runs both (which slides a window instead of resizing it), so the
# choice is made here from i3's own success report. The right/bottom border is
# preferred; for the last window in a split there is none, so the left/top
# border is used instead. A floating window can always resize, so it takes the
# first branch and its right/bottom edge follows the arrow.
set -uo pipefail
step='10 px or 10 ppt'

run() {
  local reply
  reply=$(i3-msg "resize $1 $step" 2>/dev/null) || return 1
  [[ -n "$reply" && "$reply" != *'"success":false'* ]]
}

case "${1:-}" in
  right) run 'grow right'   || run 'shrink left' ;;
  left)  run 'shrink right' || run 'grow left'   ;;
  down)  run 'grow down'    || run 'shrink up'   ;;
  up)    run 'shrink down'  || run 'grow up'     ;;
  *) printf 'Usage: kali-i3-resize [left|right|up|down]\n' >&2; exit 2 ;;
esac
exit 0
