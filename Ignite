cat > "$STAGE_DIR/bin/kali-i3-battery-block" <<'BATTERY_BLOCK'
#!/usr/bin/env bash
# Battery percentage for the bar.
#
# A VMware guest sees no battery unless the host is set to pass power status
# through, and Kali in Fusion has none by default. Rather than show a fake 0%,
# print nothing: i3blocks leaves out a block whose output is empty, so the item
# simply appears once a battery exists.
#
# KALI_I3_POWER_SUPPLY exists so the formatting can be tested against a fake
# sysfs tree; it defaults to the real one.
shopt -s nullglob
supply_dir=${KALI_I3_POWER_SUPPLY:-/sys/class/power_supply}

for battery in "$supply_dir"/BAT*; do
  [[ -r "$battery/capacity" ]] || continue
  read -r percent < "$battery/capacity" || continue
  [[ "$percent" =~ ^[0-9]+$ ]] || continue
  state=
  [[ -r "$battery/status" ]] && read -r state < "$battery/status"

  # The label carries a % sign, so it is an argument to printf and never the
  # format string: bash rejects "87%" as an unfinished conversion spec.
  if [[ "$state" == Charging ]]; then
    label="⚡ ${percent}%"
  else
    label="🔋 ${percent}%"
  fi

  # Quiet until it matters: amber under 30, phoenix red under 15.
  if [[ "$state" != Charging && "$percent" -lt 15 ]]; then
    printf '%s\n\n%s\n' "$label" '#d84962'
  elif [[ "$state" != Charging && "$percent" -lt 30 ]]; then
    printf '%s\n\n%s\n' "$label" '#d8a04a'
  else
    printf '%s\n' "$label"
  fi
  exit 0
done
exit 0
BATTERY_BLOCK

