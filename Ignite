#!/usr/bin/env bash
# ignite — Black Ph03n1x workstation setup (Kali i3 + Donut) for a fresh VMware Fusion snapshot.
# Ignite your Black Ph03n1x workstation. Run as your normal Kali user: ./ignite
#
# ─────────────────────────── DISCLAIMER ───────────────────────────
# Version 1.3.2. This is a personal setup script, shared as-is.
# It was built and tested on ONE machine only: my personal MacBook with an
# Apple Silicon (ARM) processor, running Kali Linux as an ARM64 guest in
# VMware Fusion. It is NOT guaranteed to work on other hardware, other
# hypervisors, Intel/AMD (x86) hosts, or different Kali versions.
# Use at your own risk. No warranty of any kind.  —  https://ph03n1x.net
# ───────────────────────────────────────────────────────────────────
set -Eeuo pipefail

readonly APP_NAME="ignite"
readonly APP_VERSION="1.3.2"
readonly KALI_MIRROR="https://http.kali.org/kali"
MODE=install
INSTALL_DONUT=1
INSTALL_VEIL=1
INSTALL_SHELLTER=1
INSTALL_OBSIDIAN=1
INSTALL_TLOGGER=1
USER_NAME=ph03n1x
STAGE_DIR=
BACKUP_DIR=
DESKTOP_INSTALLED=0
# Progress-UI state: when UI_ON=1 the phoenix stays on screen, noisy command
# output goes to $LOG, and each phase redraws a progress bar on the terminal.
UI_ON=0
LOG=
UI_STEP=0
UI_TOTAL=1
UI_CUR=
declare -a UI_DONE=()

say() { printf '[%s] %s\n' "$APP_NAME" "$*"; }
die() {
  printf '[%s] ERROR: %s\n' "$APP_NAME" "$*" >&2
  # If the progress UI redirected output, also show the error on the real screen.
  [[ "${UI_ON:-0}" -eq 1 ]] && printf '\n   \033[1;31mERROR: %s\033[0m\n' "$*" >&3 2>/dev/null
  exit 1
}

usage() {
  printf 'ignite v%s — Black Ph03n1x workstation setup\n\n' "$APP_VERSION"
  cat <<'USAGE'
Usage: ./ignite [OPTIONS]

  (no option)      Show the interactive menu. Non-interactive runs do a full install.
  --desktop-only   Install the desktop without Donut, Veil, Shellter, Obsidian or TLoggerV3.1
  --skip-veil      Full install, but skip Veil and Shellter (Donut/Obsidian still install)
  --no-obsidian    Full install, but skip Obsidian
  --no-tlogger     Full install, but skip TLoggerV3.1
  --username NAME  Set your username (default: ph03n1x) — used in Obsidian vault and TLoggerV3.1
  --theme-only     Upgrade an existing install's theme; leave tools alone
  --transparent    Experimental: enable terminal transparency after install
  --safe-mode      Force opaque terminals and stop Picom (if transparency glitches)
  --patch          Apply post-install fixes (Wine noise, etc.) to an existing install
  --check          Check the installed desktop and tools
  --help           Show this message

Run this inside Kali as your normal user, not with sudo. The script requests
sudo only for Kali packages. It backs up any configuration it replaces.
Keep black_phoenix.png on the Desktop (or beside the script) for the
illustrated wallpaper; a dark built-in fallback is used if it is missing.

DISCLAIMER
  Personal setup script, shared as-is. Built and tested on ONE machine only:
  a personal MacBook with an Apple Silicon (ARM) processor, running Kali Linux
  as an ARM64 guest in VMware Fusion. NOT guaranteed to work on other hardware,
  other hypervisors, Intel/AMD (x86) hosts, or different Kali versions.
  Use at your own risk. No warranty of any kind.   https://ph03n1x.net
USAGE
}

